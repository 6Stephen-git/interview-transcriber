# OBS 面经转写平台配置
# 复制为 .env 后按需修改：
#   copy .env.example .env

# ===================================================================
# === 应用数据路径（可选，默认使用项目内 data/ 目录）===
# ===================================================================
# 覆盖整个数据目录（数据库 / 托管录像 / 工作目录都会放到该目录下）
# INTERVIEW_APP_DATA_DIR=D:\obs-transcriber\data

# 单独覆盖数据库 / 托管录像 / 工作目录路径
# INTERVIEW_APP_DATABASE=D:\obs-transcriber\data\interviews.sqlite3
# INTERVIEW_APP_MANAGED_DIR=D:\obs-transcriber\data\managed-recordings
# INTERVIEW_APP_WORK_DIR=D:\obs-transcriber\data\work

# ===================================================================
# === 模型缓存目录（可选）===
# ===================================================================
# 默认缓存到用户目录；启动面经平台.bat 固定使用 data\huggingface
# HF_HOME=D:\obs-transcriber\data\huggingface
